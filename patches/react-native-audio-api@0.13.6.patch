+/// Native hardware admissions remain charged through conversion, CallInvoker,
+/// JS and network delivery. JS delivery alone never releases an admission.
+class VoiceCaptureBudget : public std::enable_shared_from_this<VoiceCaptureBudget> {
+ public:
+  void configure(double durationUs, double ageUs) {
+    std::scoped_lock lock(mutex_);
+    durationLimit_ = durationUs; ageLimit_ = ageUs;
+  }
+  bool enabled() const { std::scoped_lock lock(mutex_); return durationLimit_ > 0 || ageLimit_ > 0; }
+  bool active() const { std::scoped_lock lock(mutex_); return active_; }
+  void begin() {
+    std::scoped_lock lock(mutex_);
+    ++session_; active_ = true; expiryLatched_ = false; usedUs_ = 0; rawUs_ = 0; permits_.clear(); raw_.clear(); oldestRaw_ = Clock::now();
+  }
+  void end() {
+    std::scoped_lock lock(mutex_);
+    active_ = false; expiryLatched_ = false; usedUs_ = 0; rawUs_ = 0; permits_.clear(); raw_.clear(); ++session_;
+  }
+  bool admitHardware(double durationUs) {
+    std::scoped_lock lock(mutex_);
+    if (durationLimit_ == 0 && ageLimit_ == 0) return true;
+    const auto now = Clock::now();
+    if (expired(now)) expiryLatched_ = true;
+    if (!active_ || expiryLatched_ || (durationLimit_ > 0 && usedUs_ + durationUs > durationLimit_)) return false;
+    if (rawUs_ == 0) oldestRaw_ = now;
+    rawUs_ += durationUs; usedUs_ += durationUs;
+    raw_.push_back(Permit{durationUs, now});
+    return true;
+  }
+  std::string issue(double durationUs) {
+    std::scoped_lock lock(mutex_);
+    if (durationLimit_ == 0 && ageLimit_ == 0) return {};
+    const auto now = Clock::now();
+    if (expired(now)) expiryLatched_ = true;
+    if (!active_ || expiryLatched_ || durationUs <= 0 || rawUs_ + 1.0 < durationUs) return {};
+    const auto id = std::to_string(identity_) + ":" + std::to_string(session_) + ":" + std::to_string(++sequence_);
+    const double charge = std::min(rawUs_, durationUs);
+    permits_.emplace(id, Permit{charge, oldestRaw_}); rawUs_ = std::max(0.0, rawUs_ - charge);
+    double remaining = charge;
+    while (remaining > 0 && !raw_.empty()) {
+      const double consumed = std::min(raw_.front().durationUs, remaining);
+      raw_.front().durationUs -= consumed; remaining -= consumed;
+      if (raw_.front().durationUs <= 0.000001) raw_.pop_front();
+    }
+    oldestRaw_ = raw_.empty() ? now : raw_.front().admitted;
+    return id;
+  }
+  bool current(const std::string &id) const {
+    std::scoped_lock lock(mutex_);
+    if (expired(Clock::now())) expiryLatched_ = true;
+    return active_ && !expiryLatched_ && permits_.find(id) != permits_.end();
+  }
+  bool hasExpired() const { std::scoped_lock lock(mutex_); return active_ && (expiryLatched_ || expired(Clock::now())); }
+  void acknowledge(const std::string &id) {
+    std::scoped_lock lock(mutex_);
+    // A late server disposition may not erase proof of an exceeded age limit.
+    if (expired(Clock::now())) expiryLatched_ = true;
+    if (expiryLatched_) return;
+    const auto found = permits_.find(id);
+    if (!active_ || found == permits_.end()) return;
+    usedUs_ = std::max(0.0, usedUs_ - found->second.durationUs); permits_.erase(found);
+  }
+ private:
+  using Clock = std::chrono::steady_clock;
+  struct Permit { double durationUs; Clock::time_point admitted; };
+  bool expired(Clock::time_point now) const {
+    if (ageLimit_ <= 0) return false;
+    if (rawUs_ > 0 && std::chrono::duration<double, std::micro>(now - oldestRaw_).count() > ageLimit_) return true;
+    for (const auto &entry : permits_) if (std::chrono::duration<double, std::micro>(now - entry.second.admitted).count() > ageLimit_) return true;
+    return false;
+  }
+  inline static std::atomic<uint64_t> nextIdentity_{0};
+  const uint64_t identity_{++nextIdentity_};
+  mutable std::mutex mutex_;
+  double durationLimit_{0}, ageLimit_{0}, usedUs_{0}, rawUs_{0};
+  uint64_t session_{0}, sequence_{0};
+  bool active_{false};
+  mutable bool expiryLatched_{false};
+  Clock::time_point oldestRaw_;
+  std::unordered_map<std::string, Permit> permits_;
+  std::deque<Permit> raw_;
+};
