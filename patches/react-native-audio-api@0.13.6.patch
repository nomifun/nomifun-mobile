+package com.swmansion.audioapi.system
+
+import android.content.Context
+import android.media.AudioManager
+import android.media.AudioDeviceCallback
+import android.media.AudioDeviceInfo
+import android.os.Handler
+import android.os.Looper
+import com.facebook.react.bridge.ReactApplicationContext
+import com.swmansion.audioapi.AudioAPIModule
+import java.lang.ref.WeakReference
+
+/** Requested only by opt-in voice recorders. Never changes the default SDK mode. */
+object VoiceCommunicationMode {
+  private var context = WeakReference<ReactApplicationContext>(null)
+  private var module = WeakReference<AudioAPIModule>(null)
+  private var owned = false
+  private val owners = mutableSetOf<Long>()
+  private var priorMode = AudioManager.MODE_NORMAL
+  private var routes = emptySet<Int>()
+  private var routeCallback: AudioDeviceCallback? = null
+  @JvmStatic fun initialize(value: ReactApplicationContext, owner: AudioAPIModule) {
+    context = WeakReference(value); module = WeakReference(owner)
+  }
+  @Synchronized private fun routeChanged() {
+    if (!owned) return
+    val manager = context.get()?.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return
+    val current = manager.getDevices(AudioManager.GET_DEVICES_ALL).map { it.id }.toSet()
+    if (current == routes) return
+    routes = current
+    module.get()?.invokeHandlerWithEventNameAndEventBody(AudioEvent.ROUTE_CHANGE.ordinal,
+      mapOf("reason" to "ConfigurationChange"))
+  }
+  @JvmStatic @Synchronized fun setActive(ownerId: Long, active: Boolean): Boolean {
+    val manager = context.get()?.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return false
+    if (active) {
+      if (!owners.add(ownerId) || owners.size > 1) return true
+      priorMode = manager.mode
+      try { manager.mode = AudioManager.MODE_IN_COMMUNICATION }
+      catch (_: SecurityException) { owners.remove(ownerId); return false }
+      owned = true
+      routes = manager.getDevices(AudioManager.GET_DEVICES_ALL).map { it.id }.toSet()
+      routeCallback = object : AudioDeviceCallback() {
+        override fun onAudioDevicesAdded(devices: Array<out AudioDeviceInfo>) { routeChanged() }
+        override fun onAudioDevicesRemoved(devices: Array<out AudioDeviceInfo>) { routeChanged() }
+      }
+      manager.registerAudioDeviceCallback(routeCallback, Handler(Looper.getMainLooper()))
+    } else {
+      if (!owners.remove(ownerId) || owners.isNotEmpty()) return true
+      // Do not overwrite a mode subsequently owned by a phone call/other app.
+      var restored = true
+      try { if (manager.mode == AudioManager.MODE_IN_COMMUNICATION) manager.mode = priorMode }
+      catch (_: SecurityException) { restored = false }
+      owned = false
+      routeCallback?.let { manager.unregisterAudioDeviceCallback(it) }
+      routeCallback = null; routes = emptySet()
+      return restored
+    }
+    return true
+  }
+}
