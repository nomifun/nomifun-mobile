+  if (epoch != sinkEpochSequence_.load(std::memory_order_acquire)) return {};
+  if (position > written || position + offset < 0) return {};
+  return {.contextTime = (position + offset) / sampleRate_, .performanceTime = -1,
+          .latency = static_cast<double>(written - position) / sampleRate_, .known = true,
+          .timelineId = timeline};
