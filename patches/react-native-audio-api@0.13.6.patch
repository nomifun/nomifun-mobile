+}
+
+bool AudioRecorder::admitVoiceHardware(double durationUs) {
+  if (voiceRevoked_.load() || (foregroundOnly_ && !VoicePolicyRegistry::isForeground())) return false;
+  if (captureBudget_->admitHardware(durationUs)) return true;
+  revokeVoicePolicy("backlog"); return false;
+}
