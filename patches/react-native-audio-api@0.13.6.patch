+  const uint64_t epoch = sinkEpochSequence_.load(std::memory_order_acquire);
+  if ((epoch & 1) != 0) return {};
+  const double offset = sinkContextOffset_.load();
+  const int64_t timeline = sinkTimelineId_.load();
