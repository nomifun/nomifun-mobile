+/// Only explicit foreground-only clients join this registry. Default SDK
+/// sessions keep their existing background and interruption behavior.
+class VoicePolicyTarget {
+ public:
+  virtual ~VoicePolicyTarget() = default;
+  virtual void revokeVoicePolicy(const std::string &reason) = 0;
+  virtual void checkVoicePolicy() {}
+};
+
+class VoicePolicyRegistry {
+ public:
+  static bool isForeground() { return state().foreground.load(std::memory_order_acquire); }
+  static void registerTarget(const std::shared_ptr<VoicePolicyTarget> &target) {
+    if (!target) return;
+    auto &registry = state();
+    {
+      std::scoped_lock lock(registry.mutex);
+      registry.targets.erase(std::remove_if(registry.targets.begin(), registry.targets.end(), [](auto &item) { return item.expired(); }), registry.targets.end());
+      if (std::none_of(registry.targets.begin(), registry.targets.end(), [&](auto &item) { return item.lock() == target; })) registry.targets.push_back(target);
+      registry.startMonitor();
+    }
+    registry.wake.notify_one();
+    // A pause may predate target construction. Registration must not grant a
+    // lease merely because no target existed when the pause was delivered.
+    if (!isForeground()) target->revokeVoicePolicy("background");
+  }
+  static void setForeground(bool foreground) {
+    state().foreground.store(foreground, std::memory_order_release);
+    if (!foreground) revoke("background");
+  }
+  static void revoke(const std::string &reason) {
+    std::vector<std::shared_ptr<VoicePolicyTarget>> targets;
+    {
+      auto &registry = state();
+      std::scoped_lock lock(registry.mutex);
+      for (auto &item : registry.targets) if (auto target = item.lock()) targets.push_back(std::move(target));
+    }
+    for (auto &target : targets) target->revokeVoicePolicy(reason);
+  }
+ private:
+  struct State {
+    std::atomic<bool> foreground{true};
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::vector<std::weak_ptr<VoicePolicyTarget>> targets;
+    bool exiting{false};
+    std::thread monitor;
+    void startMonitor() {
+      if (monitor.joinable()) return;
+      monitor = std::thread([this]() {
+      std::unique_lock lock(mutex);
+      while (!exiting) {
+        targets.erase(std::remove_if(targets.begin(), targets.end(), [](auto &item) { return item.expired(); }), targets.end());
+        if (targets.empty()) wake.wait(lock, [this]() { return exiting || !targets.empty(); });
+        if (exiting) break;
+        wake.wait_for(lock, std::chrono::milliseconds(10), [this]() { return exiting; });
+        if (exiting) break;
+        std::vector<std::shared_ptr<VoicePolicyTarget>> current;
+        for (auto &item : targets) if (auto target = item.lock()) current.push_back(std::move(target));
+        lock.unlock();
+        // Age expiry cannot depend on another hardware frame or a JS turn.
+        for (auto &target : current) target->checkVoicePolicy();
+        lock.lock();
+      }
+      });
+    }
+    ~State() {
+      { std::scoped_lock lock(mutex); exiting = true; }
+      wake.notify_one();
+      if (monitor.joinable()) monitor.join();
+    }
+  };
+  static State &state() { static State registry; return registry; }
+};
