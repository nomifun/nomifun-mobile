{
  "expo": {
    "name": "Nomifun",
    "slug": "nomifun-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "nomifun",
      "nomi"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nomifun.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "仅在您点击开始语音后，用于与所选 Desktop Agent 实时交谈",
        "NSCameraUsageDescription": "用于扫描桌面端二维码以建立连接",
        "NSLocalNetworkUsageDescription": "用于连接同一局域网内的 Nomifun 桌面端",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131119",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nomifun.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131119",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用于扫描桌面端二维码以建立连接"
        }
      ],
      "expo-notifications",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "仅在您点击开始语音后，用于与所选 Desktop Agent 实时交谈",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "disableFFmpeg": true
        }
      ],
      [
        "./plugins/with-desktop-networking",
        {
          "usesCleartextTraffic": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ],
      "expo-secure-store",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e03c8666-94b8-48b2-bfd2-852e234c41d5"
      }
    },
    "owner": "nomifuns-team"
  }
}
